{
  "functions": {
    "api/blog-index.js": { "includeFiles": "blog.html" }
  },
  "rewrites": [
    { "source": "/blog/sitemap.xml", "destination": "/api/blog-sitemap" },
    { "source": "/blog/:slug", "destination": "/api/blog-article?slug=:slug" },
    { "source": "/blog", "destination": "/api/blog-index" },
    { "source": "/blog/", "destination": "/api/blog-index" }
  ]
}
