{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Fandom Room",
  "version": "0.1.0",
  "description": "Open the Fandom Room discussion for what you’re watching.",
  "icons": {
    "16": "logo/fandom-room-icon.png",
    "32": "logo/fandom-room-icon.png",
    "48": "logo/fandom-room-icon.png",
    "128": "logo/fandom-room-icon.png"
  },
  "permissions": ["sidePanel", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.animeheaven.me/*",
    "https://*.crunchyroll.com/*",
    "https://zbayifekoqasimvqreav.supabase.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open this page’s Fandom Room discussion",
    "default_icon": "logo/fandom-room-icon.png"
  },
  "side_panel": {
    "default_path": "extension.html"
  }
}
