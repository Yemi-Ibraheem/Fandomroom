{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Fandom Room",
  "version": "0.1.0",
  "description": "Open the Fandom Room discussion for what you’re watching.",
  "icons": {
    "128": "logo/128.png",
    "48": "logo/48.png",
    "16": "logo/16.png"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.animeheaven.me/*",
    "https://*.crunchyroll.com/*",
    "https://zbayifekoqasimvqreav.supabase.co/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open this page’s Fandom Room discussion",
    "default_icon": {
      "16": "logo/16.png",
      "48": "logo/48.png"
    }
  },
  "side_panel": {
    "default_path": "extension.html"
  }
}
